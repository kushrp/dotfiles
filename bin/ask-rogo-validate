#!/usr/bin/env zsh

set -u

usage() {
  print -u2 -- "Usage: ask-rogo-validate [--] <command> [arguments...]"
}

if (( $# == 0 )); then
  usage
  exit 64
fi

if [[ $1 == "--" ]]; then
  shift
fi

if (( $# == 0 )); then
  usage
  exit 64
fi

lock_file=${ASK_ROGO_VALIDATION_LOCK:-${TMPDIR:-/tmp}/ask-rogo-heavy-validation.lock}
timeout_duration=${ASK_ROGO_VALIDATION_TIMEOUT:-20m}
timeout_bin=${ASK_ROGO_VALIDATION_TIMEOUT_BIN:-}

if [[ -z $timeout_bin ]]; then
  timeout_bin=$(command -v timeout 2>/dev/null || command -v gtimeout 2>/dev/null || true)
fi

if [[ -z $timeout_bin ]]; then
  print -u2 -- "ask-rogo-validate: install GNU coreutils to provide timeout"
  exit 69
fi

if ! /usr/bin/shlock -p $$ -f "$lock_file"; then
  owner_pid=$(tr -cd '0-9' < "$lock_file" 2>/dev/null || true)
  if [[ -n $owner_pid ]] && kill -0 "$owner_pid" 2>/dev/null; then
    print -u2 -- "ask-rogo-validate: validation is already running under PID $owner_pid"
    exit 75
  fi

  print -u2 -- "ask-rogo-validate: stale lock at $lock_file"
  print -u2 -- "Confirm no validation is running, then remove that file and retry."
  exit 69
fi

cleanup() {
  local recorded_pid
  recorded_pid=$(tr -cd '0-9' < "$lock_file" 2>/dev/null || true)
  if [[ $recorded_pid == $$ ]]; then
    rm -f -- "$lock_file"
  fi
}

runner_pid=0

forward_signal() {
  local signal_name=$1
  local signal_status=$2

  trap - HUP INT TERM
  if (( runner_pid > 0 )); then
    kill -s "$signal_name" -- "-$runner_pid" 2>/dev/null || \
      kill -s "$signal_name" "$runner_pid" 2>/dev/null || true
    wait "$runner_pid" 2>/dev/null || true
  fi
  exit "$signal_status"
}

trap cleanup EXIT
trap 'forward_signal HUP 129' HUP
trap 'forward_signal INT 130' INT
trap 'forward_signal TERM 143' TERM

export TURBO_CONCURRENCY=1

"$timeout_bin" --verbose --signal=TERM --kill-after=30s "$timeout_duration" "$@" &
runner_pid=$!
wait "$runner_pid"
exit_code=$?
runner_pid=0

exit $exit_code
